# =============================================================================
# AI Resume Screening Telegram Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Telegram Bot Configuration ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Gemini API Configuration (Primary LLM Provider) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite

# --- Deterministic Screening Weights (must total 100 for a 100-point score) ---
SCORE_WEIGHT_TECHNICAL_SKILLS=40
SCORE_WEIGHT_PROJECTS=20
SCORE_WEIGHT_EXPERIENCE=20
SCORE_WEIGHT_EDUCATION=10
SCORE_WEIGHT_CERTIFICATIONS=10
# Temperature 0 for deterministic outputs (PRD §12)
GEMINI_TEMPERATURE=0.0
# Maximum tokens for LLM responses
GEMINI_MAX_TOKENS=4096

# --- OpenRouter Configuration (Fallback LLM Provider) ---
# Used automatically when Gemini API fails or is rate-limited.
# OpenRouter provides access to multiple models via an OpenAI-compatible API.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Application Configuration ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Directory for temporary file uploads (cleaned on /reset)
UPLOAD_DIR=uploads
# Directory for log files
LOG_DIR=logs
# Maximum file size in bytes (default 10MB)
MAX_FILE_SIZE_BYTES=10485760
# Maximum number of resumes per session
MAX_RESUMES_PER_SESSION=20

# --- FastAPI Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
